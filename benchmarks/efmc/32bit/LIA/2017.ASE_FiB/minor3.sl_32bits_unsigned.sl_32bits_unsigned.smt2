(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (and (bvule x #x00000005)
     (bvuge x #x00000004)
     (bvule y #x00000005)
     (bvuge y #x00000004)) (inv x y))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32))) 
      (=> (and (inv x y) (or (and (= x! (bvsub x #x00000001))
         (= y! y)
         (bvuge x #x00000000)
         (bvuge y #x00000000))
    (and (= x! x)
         (= y! (bvsub y #x00000001))
         (bvult x #x00000000)
         (bvuge y #x00000000))
    (and (= x! (bvadd x #x00000001))
         (= y! (bvsub y #x00000001))
         (bvult y #x00000000)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (inv x y) (and (bvule y #x00000005)))))
(check-sat)
