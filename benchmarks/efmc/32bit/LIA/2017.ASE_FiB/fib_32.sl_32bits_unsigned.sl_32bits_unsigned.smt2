(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((k (_ BitVec 32)) (b (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (and (bvugt k #x00000000)
     (= i j)
     (= n #x00000000)
     (or (= b #x00000001) (= b #x00000000))) (inv k b i j n))))
(assert (forall ((k (_ BitVec 32)) (b (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32)) (n (_ BitVec 32)) (k! (_ BitVec 32)) (b! (_ BitVec 32)) (i! (_ BitVec 32)) (j! (_ BitVec 32)) (n! (_ BitVec 32))) 
      (=> (and (inv k b i j n) (or (and (bvuge n (bvmul #x00000002 k))
         (= k! k)
         (= b! b)
         (= i! i)
         (= j! j)
         (= n! n))
    (and (bvult n (bvmul #x00000002 k))
         (= b #x00000001)
         (= k! k)
         (= b! #x00000000)
         (= i! (bvadd i #x00000001))
         (= j! j)
         (= n! (bvadd n #x00000001)))
    (and (bvult n (bvmul #x00000002 k))
         (not (= b #x00000001))
         (= k! k)
         (= b! #x00000001)
         (= i! i)
         (= j! (bvadd j #x00000001))
         (= n! (bvadd n #x00000001))))) (inv k! b! i! j! n!))))
(assert (forall ((k (_ BitVec 32)) (b (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (inv k b i j n) (=> (bvuge n (bvmul #x00000002 k)) (= i j)))))
(check-sat)
