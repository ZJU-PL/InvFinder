(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (= x #x00000001) (inv x y))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32))) 
      (=> (and (inv x y) (and (bvule x #x0000000a)
     (= y! (bvsub #x0000000a x))
     (= x! (bvadd x #x00000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (inv x y) (not (and (bvule x #x0000000a)
          (= y (bvsub #x0000000a x))
          (or (bvuge y #x0000000a) (bvugt #x00000000 y)))))))
(check-sat)
