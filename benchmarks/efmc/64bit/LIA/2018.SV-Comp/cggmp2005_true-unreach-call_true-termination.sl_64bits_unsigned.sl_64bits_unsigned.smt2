(set-logic HORN)
(declare-fun inv ((_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((i (_ BitVec 64)) (j (_ BitVec 64))) 
      (=> (and (= i #x0000000000000001) (= j #x000000000000000a)) (inv i j))))
(assert (forall ((i (_ BitVec 64)) (j (_ BitVec 64)) (i! (_ BitVec 64)) (j! (_ BitVec 64))) 
      (=> (and (inv i j) (and (bvuge j i)
     (= i! (bvadd i #x0000000000000002))
     (= j! (bvadd j (bvsub #x0000000000000000 #x0000000000000001))))) (inv i! j!))))
