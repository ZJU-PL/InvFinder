(set-logic HORN)
(declare-fun inv ((_ BitVec 32) ) Bool)
(assert (forall ((c (_ BitVec 32))) 
      (=> (= c #x00000000) (inv c))))
(assert (forall ((c (_ BitVec 32)) (c! (_ BitVec 32))) 
      (=> (and (inv c) (or (and (not (= c #x00000028)) (= c! (bvadd c #x00000001)))
    (and (= c #x00000028) (= c! #x00000001)))) (inv c!))))
(assert (forall ((c (_ BitVec 32))) 
      (=> (inv c) (not (and (not (= c #x00000028))
          (or (bvult c #x00000000) (bvugt c #x00000028)))))))
(check-sat)
