(set-logic HORN)
(declare-fun inv ((_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (and (= x #x0000000000000001) (= y #x0000000000000000)) (inv x y))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64))) 
      (=> (and (inv x y) (and (bvult y #x0000000000000400)
     (= x! #x0000000000000000)
     (= y! (bvadd y #x0000000000000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (inv x y) (or (bvult y #x0000000000000400) (= x #x0000000000000000)))))
(check-sat)
