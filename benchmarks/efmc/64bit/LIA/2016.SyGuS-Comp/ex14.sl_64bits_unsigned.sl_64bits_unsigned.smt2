(declare-fun inv ((_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (= x #x0000000000000001) (inv x y))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64))) 
      (=> (and (inv x y) (and (bvule x #x000000000000000a)
     (= y! (bvsub #x000000000000000a x))
     (= x! (bvadd x #x0000000000000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (inv x y) (not (and (bvule x #x000000000000000a)
