(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (and (= j #x00000000)
     (bvugt x #x00000000)
     (= i #x00000000)) (inv x i j))))
(assert (forall ((x (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32)) (x! (_ BitVec 32)) (i! (_ BitVec 32)) (j! (_ BitVec 32))) 
      (=> (and (inv x i j) (or (and (bvult i x)
         (= j! (bvadd j #x00000002))
         (= i! (bvadd i #x00000001))
         (= x! x))
    (and (bvuge i x) (= j! j) (= i! i) (= x! x)))) (inv x! i! j!))))
(assert (forall ((x (_ BitVec 32)) (i (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (inv x i j) (=> (not (bvult i x)) (= j (bvmul #x00000002 x))))))
(check-sat)
