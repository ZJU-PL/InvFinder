      (=> (= x (bvadd #x0000000000000001 (bvnot #x0000000000000032))) (inv x y))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64))) 
      (=> (and (inv x y) (or (and (bvult x #x0000000000000000)
