(set-logic HORN)
(declare-fun inv ((_ BitVec 64) (_ BitVec 64) (_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (w (_ BitVec 64)) (z (_ BitVec 64))) 
      (=> (and (= w #x0000000000000001)
     (= z #x0000000000000000)
     (= x #x0000000000000000)
     (= y #x0000000000000000)) (inv x y w z))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (w (_ BitVec 64)) (z (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64)) (w! (_ BitVec 64)) (z! (_ BitVec 64))) 
      (=> (and (inv x y w z) (or (and (= w #x0000000000000001)
         (= z #x0000000000000000)
         (= x! (bvadd x #x0000000000000001))
         (= w! #x0000000000000000)
         (= y! (bvadd y #x0000000000000001))
         (= z! #x0000000000000001))
    (and (not (= w #x0000000000000001))
         (= z #x0000000000000000)
         (= x! x)
         (= w! w)
         (= y! (bvadd y #x0000000000000001))
         (= z! #x0000000000000001))
    (and (= w #x0000000000000001)
         (not (= z #x0000000000000000))
         (= x! (bvadd x #x0000000000000001))
         (= w! #x0000000000000000)
         (= y! y)
         (= z! z))
    (and (not (= w #x0000000000000001))
         (not (= z #x0000000000000000))
         (= x! x)
         (= w! w)
         (= y! y)
         (= z! z)))) (inv x! y! w! z!))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (w (_ BitVec 64)) (z (_ BitVec 64))) 
      (=> (inv x y w z) (= x y))))
(check-sat)
