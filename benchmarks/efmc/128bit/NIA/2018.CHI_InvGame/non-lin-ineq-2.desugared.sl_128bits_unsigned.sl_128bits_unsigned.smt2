(set-logic HORN)
(declare-fun inv ((_ BitVec 128) (_ BitVec 128) (_ BitVec 128) ) Bool)
(assert (forall ((i (_ BitVec 128)) (j (_ BitVec 128)) (k (_ BitVec 128))) 
      (=> (and (= i #x00000000000000000000000000000000)
     (bvugt j #x00000000000000000000000000000000)
     (bvugt k #x00000000000000000000000000000000)) (inv i j k))))
(assert (forall ((i (_ BitVec 128)) (j (_ BitVec 128)) (k (_ BitVec 128)) (i! (_ BitVec 128)) (j! (_ BitVec 128)) (k! (_ BitVec 128))) 
      (=> (and (inv i j k) (and (bvult i (bvmul j k))
     (= i! (bvadd i #x00000000000000000000000000000001))
     (= j! j)
     (= k! k))) (inv i! j! k!))))
(assert (forall ((i (_ BitVec 128)) (j (_ BitVec 128)) (k (_ BitVec 128))) 
      (=> (inv i j k) (or (bvult i (bvmul j k)) (= i (bvmul j k))))))
(check-sat)
