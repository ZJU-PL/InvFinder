(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (z (_ BitVec 32)) (w (_ BitVec 32))) 
      (=> (and (= x #x00000000)
     (= y #x00000000)
     (= z #x00000000)
     (= w #x00000000)) (inv x y z w))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (z (_ BitVec 32)) (w (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32)) (z! (_ BitVec 32)) (w! (_ BitVec 32))) 
      (=> (and (inv x y z w) (or (and (= x! (bvadd x #x00000001))
         (= y! (bvadd y #x00000002))
         (= z! z)
         (= w! w))
    (and (bvuge x #x00000004)
         (= x! (bvadd x #x00000001))
         (= y! (bvadd y #x00000003))
         (= z! (bvadd z #x0000000a))
         (= w! (bvadd w #x0000000a)))
    (and (bvuge x z)
         (bvugt w y)
         (= x! (bvsub #x00000000 x))
         (= y! (bvsub #x00000000 y))
         (= z! z)
         (= w! w)))) (inv x! y! z! w!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (z (_ BitVec 32)) (w (_ BitVec 32))) 
      (=> (inv x y z w) (bvuge (bvmul #x00000003 x) y))))
(check-sat)
