(set-logic HORN)
(declare-fun inv ((_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (= x (bvadd #x0000000000000001 (bvnot #x0000000000001388))) (inv x y))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64))) 
      (=> (and (inv x y) (and (bvult x #x0000000000000000)
     (= x! (bvadd x y))
     (= y! (bvadd y #x0000000000000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (inv x y) (not (and (bvuge x #x0000000000000000) (bvule y #x0000000000000000))))))
(check-sat)
