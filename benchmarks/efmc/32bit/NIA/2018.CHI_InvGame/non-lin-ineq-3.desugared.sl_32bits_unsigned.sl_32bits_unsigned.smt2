(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((i (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (and (= i #x00000000) (= k #x00000000)) (inv i k))))
(assert (forall ((i (_ BitVec 32)) (k (_ BitVec 32)) (i! (_ BitVec 32)) (k! (_ BitVec 32))) 
      (=> (and (inv i k) (and (bvult i #x000003e8)
     (= i! (bvadd i #x00000001))
     (= k! (bvadd k (bvmul i! i!))))) (inv i! k!))))
(assert (forall ((i (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (inv i k) (or (bvult i #x000003e8) (bvule #x000f4240 k)))))
(check-sat)
