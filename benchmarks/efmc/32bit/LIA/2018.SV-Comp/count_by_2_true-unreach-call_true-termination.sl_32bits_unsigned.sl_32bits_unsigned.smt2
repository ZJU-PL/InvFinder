(set-logic HORN)
(declare-fun inv ((_ BitVec 32) ) Bool)
(assert (forall ((i (_ BitVec 32))) 
      (=> (= i #x00000000) (inv i))))
(assert (forall ((i (_ BitVec 32)) (i! (_ BitVec 32))) 
      (=> (and (inv i) (and (bvult i #x000f4240) (= i! (bvadd i #x00000002)))) (inv i!))))
(assert (forall ((i (_ BitVec 32))) 
      (=> (inv i) (or (bvult i #x000f4240) (= i #x000f4240)))))
(check-sat)
