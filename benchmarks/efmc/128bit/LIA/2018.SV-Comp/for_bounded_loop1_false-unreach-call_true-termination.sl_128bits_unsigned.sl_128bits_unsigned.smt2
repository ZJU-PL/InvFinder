(set-logic HORN)
(declare-fun inv ((_ BitVec 128) (_ BitVec 128) (_ BitVec 128) (_ BitVec 128) ) Bool)
(assert (forall ((i (_ BitVec 128)) (x (_ BitVec 128)) (y (_ BitVec 128)) (n (_ BitVec 128))) 
      (=> (and (= i #x00000000000000000000000000000000)
     (= x #x00000000000000000000000000000000)
     (= y #x00000000000000000000000000000000)
     (bvugt n #x00000000000000000000000000000000)) (inv i x y n))))
(assert (forall ((i (_ BitVec 128)) (x (_ BitVec 128)) (y (_ BitVec 128)) (n (_ BitVec 128)) (i! (_ BitVec 128)) (x! (_ BitVec 128)) (y! (_ BitVec 128)) (n! (_ BitVec 128))) 
      (=> (and (inv i x y n) (and (bvult i n)
     (= x! (bvadd x y!))
     (not (= y! #x00000000000000000000000000000000))
     (= i! i)
     (= n! n))) (inv i! x! y! n!))))
(assert (forall ((i (_ BitVec 128)) (x (_ BitVec 128)) (y (_ BitVec 128)) (n (_ BitVec 128))) 
      (=> (inv i x y n) (or (bvult i n) (= x #x00000000000000000000000000000000)))))
(check-sat)
