(assert (forall ((a (_ BitVec 32)) (b (_ BitVec 32)) (res (_ BitVec 32)) (cnt (_ BitVec 32))) 
      (=> (inv a b res cnt) (or (bvugt cnt #x00000000) (= res (bvadd a b))))))
