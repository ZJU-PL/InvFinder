(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (w (_ BitVec 32)) (z (_ BitVec 32))) 
      (=> (and (= w #x00000001)
     (= z #x00000000)
     (= x #x00000000)
     (= y #x00000000)) (inv x y w z))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (w (_ BitVec 32)) (z (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32)) (w! (_ BitVec 32)) (z! (_ BitVec 32))) 
      (=> (and (inv x y w z) (or (and (= w #x00000001)
         (= z #x00000000)
         (= x! (bvadd x #x00000001))
         (= w! #x00000000)
         (= y! (bvadd y #x00000001))
         (= z! #x00000001))
    (and (not (= w #x00000001))
         (= z #x00000000)
         (= x! x)
         (= w! w)
         (= y! (bvadd y #x00000001))
         (= z! #x00000001))
    (and (= w #x00000001)
         (not (= z #x00000000))
         (= x! (bvadd x #x00000001))
         (= w! #x00000000)
         (= y! y)
         (= z! z))
    (and (not (= w #x00000001))
         (not (= z #x00000000))
         (= x! x)
         (= w! w)
         (= y! y)
         (= z! z)))) (inv x! y! w! z!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (w (_ BitVec 32)) (z (_ BitVec 32))) 
      (=> (inv x y w z) (= x y))))
(check-sat)
