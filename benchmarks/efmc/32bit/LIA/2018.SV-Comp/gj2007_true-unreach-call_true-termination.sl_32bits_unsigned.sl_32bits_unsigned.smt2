(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (and (= x #x00000000) (= y #x00000032)) (inv x y))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32))) 
      (=> (and (inv x y) (and (bvult x #x00000064)
     (ite (bvult x #x00000032)
          (= x! (bvadd x #x00000001))
          (= y! y))
     (= x! (bvadd x #x00000001))
     (= y! (bvadd y #x00000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (inv x y) (or (bvult x #x00000064) (= y #x00000064)))))
(check-sat)
