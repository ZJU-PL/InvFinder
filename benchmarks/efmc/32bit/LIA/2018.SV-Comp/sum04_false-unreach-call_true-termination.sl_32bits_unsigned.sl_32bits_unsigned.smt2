(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((i (_ BitVec 32)) (sn (_ BitVec 32))) 
      (=> (and (= sn #x00000000) (= i #x00000001)) (inv i sn))))
(assert (forall ((i (_ BitVec 32)) (sn (_ BitVec 32)) (i! (_ BitVec 32)) (sn! (_ BitVec 32))) 
      (=> (and (inv i sn) (and (bvule i #x00000008)
     (ite (bvult i #x00000004)
          (= sn! (bvadd sn #x00000002))
          (= sn! sn))
     (= i! (bvadd i #x00000001)))) (inv i! sn!))))
(assert (forall ((i (_ BitVec 32)) (sn (_ BitVec 32))) 
      (=> (inv i sn) (or (bvule i #x00000008)
    (= sn (bvmul #x00000008 #x00000002))
    (= sn #x00000000)))))
(check-sat)
