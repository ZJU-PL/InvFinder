(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((c (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (and (= c #x00000000) (bvugt n #x00000000)) (inv c n))))
(assert (forall ((c (_ BitVec 32)) (n (_ BitVec 32)) (c! (_ BitVec 32)) (n! (_ BitVec 32))) 
      (=> (and (inv c n) (or (and (not (= c n)) (= c! (bvadd c #x00000001)) (= n! n))
    (and (= c n) (= c! #x00000001) (= n! n)))) (inv c! n!))))
(assert (forall ((c (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (inv c n) (let ((a!1 (or (not (= c n))
               (bvugt n (bvadd #x00000001 (bvnot #x00000001))))))
  (and (or (= c n) (and (bvuge c #x00000000) (bvule c n))) a!1)))))
