      (=> (= x #x0000000000000064) (inv x))))
(assert (forall ((x (_ BitVec 64)) (x! (_ BitVec 64))) 
      (=> (and (inv x) (and (bvugt x #x0000000000000000) (= x! (bvsub x #x0000000000000001)))) (inv x!))))
