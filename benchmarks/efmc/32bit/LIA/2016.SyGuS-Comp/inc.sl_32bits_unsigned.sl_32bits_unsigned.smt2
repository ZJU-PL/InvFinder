(set-logic HORN)
(declare-fun inv ((_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32))) 
      (=> (= x #x00000000) (inv x))))
(assert (forall ((x (_ BitVec 32)) (x! (_ BitVec 32))) 
      (=> (and (inv x) (and (bvult x #x00000064) (= x! (bvadd x #x00000001)))) (inv x!))))
(assert (forall ((x (_ BitVec 32))) 
      (=> (inv x) (or (not (bvuge x #x00000064)) (= x #x00000064)))))
(check-sat)
