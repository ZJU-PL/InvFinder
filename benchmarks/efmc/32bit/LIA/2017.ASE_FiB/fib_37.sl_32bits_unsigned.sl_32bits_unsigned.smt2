(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (m (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (and (= x #x00000000)
     (= m #x00000000)
     (bvugt n #x00000000)) (inv x m n))))
(assert (forall ((x (_ BitVec 32)) (m (_ BitVec 32)) (n (_ BitVec 32)) (x! (_ BitVec 32)) (m! (_ BitVec 32)) (n! (_ BitVec 32))) 
      (=> (and (inv x m n) (or (and (bvuge x n) (= x! x) (= m! m) (= n! n))
    (and (bvult x n) (= x! (bvadd x #x00000001)) (= m! x) (= n! n))
    (and (bvult x n) (= x! (bvadd x #x00000001)) (= m! m) (= n! n)))) (inv x! m! n!))))
(assert (forall ((x (_ BitVec 32)) (m (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (inv x m n) (=> (bvuge x n)
    (or (bvule n #x00000000)
        (and (bvule #x00000000 m) (bvult m n)))))))
(check-sat)
