(set-logic HORN)
(declare-fun inv ((_ BitVec 64) (_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (and (= x #x0000000000000000) (= y #x0000000000000000)) (inv x y))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64)) (x! (_ BitVec 64)) (y! (_ BitVec 64))) 
      (=> (and (inv x y) (and (= x! x) (bvule #x0000000000000000 y) (= y! (bvadd x y)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 64)) (y (_ BitVec 64))) 
      (=> (inv x y) (bvuge y #x0000000000000000))))
(check-sat)
