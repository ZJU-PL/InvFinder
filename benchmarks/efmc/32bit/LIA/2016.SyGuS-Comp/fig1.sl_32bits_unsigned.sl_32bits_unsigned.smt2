(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (= x (bvadd #x00000001 (bvnot #x00000032))) (inv x y))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32)) (x! (_ BitVec 32)) (y! (_ BitVec 32))) 
      (=> (and (inv x y) (and (bvult x #x00000000)
     (= x! (bvadd x y))
     (= y! (bvadd y #x00000001)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 32)) (y (_ BitVec 32))) 
      (=> (inv x y) (not (and (bvuge x #x00000000) (bvule y #x00000000))))))
(check-sat)
