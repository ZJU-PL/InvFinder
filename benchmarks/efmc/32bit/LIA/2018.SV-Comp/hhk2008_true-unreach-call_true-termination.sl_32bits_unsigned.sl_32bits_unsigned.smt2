(assert (forall ((a (_ BitVec 32)) (b (_ BitVec 32)) (res (_ BitVec 32)) (cnt (_ BitVec 32))) 
      (=> (and (bvule a #x000f4240)
     (bvule #x00000000 b)
     (bvule b #x000f4240)
     (= res a)
     (= cnt b)) (inv a b res cnt))))
(assert (forall ((a (_ BitVec 32)) (b (_ BitVec 32)) (res (_ BitVec 32)) (cnt (_ BitVec 32)) (a! (_ BitVec 32)) (b! (_ BitVec 32)) (res! (_ BitVec 32)) (cnt! (_ BitVec 32))) 
      (=> (and (inv a b res cnt) (and (bvugt cnt #x00000000)
     (= cnt! (bvsub cnt #x00000001))
     (= res! (bvadd res #x00000001))
