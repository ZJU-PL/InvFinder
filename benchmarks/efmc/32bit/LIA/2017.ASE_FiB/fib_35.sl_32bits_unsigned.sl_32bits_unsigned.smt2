(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (and (bvugt n #x00000000) (= x #x00000000)) (inv x n))))
(assert (forall ((x (_ BitVec 32)) (n (_ BitVec 32)) (x! (_ BitVec 32)) (n! (_ BitVec 32))) 
      (=> (and (inv x n) (or (and (bvuge x n) (= x! x) (= n! n))
    (and (bvult x n) (= x! (bvadd x #x00000001)) (= n! n)))) (inv x! n!))))
(assert (forall ((x (_ BitVec 32)) (n (_ BitVec 32))) 
      (=> (inv x n) (=> (bvuge x n) (= x n)))))
(check-sat)
