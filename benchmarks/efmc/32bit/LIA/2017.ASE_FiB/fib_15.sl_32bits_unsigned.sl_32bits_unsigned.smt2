(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((n (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (and (= j #x00000000) (bvugt n #x00000000) (bvugt k n)) (inv n j k))))
(assert (forall ((n (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32)) (n! (_ BitVec 32)) (j! (_ BitVec 32)) (k! (_ BitVec 32))) 
      (=> (and (inv n j k) (or (and (bvult j n)
         (= j! (bvadd j #x00000001))
         (= k! (bvsub k #x00000001))
         (= n! n))
    (and (bvuge j n) (= j! j) (= k! k) (= n! n)))) (inv n! j! k!))))
(assert (forall ((n (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (inv n j k) (=> (not (bvult j n)) (bvuge k #x00000000)))))
(check-sat)
