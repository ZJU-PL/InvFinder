(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((m (_ BitVec 32)) (a (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (and (or (bvule a m) (= j #x00000000))
     (bvult j #x00000001)
     (= k #x00000000)) (inv m a j k))))
(assert (forall ((m (_ BitVec 32)) (a (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32)) (m! (_ BitVec 32)) (a! (_ BitVec 32)) (j! (_ BitVec 32)) (k! (_ BitVec 32))) 
      (=> (and (inv m a j k) (or (and (= j! j)
         (bvult k #x00000001)
         (bvult m a!)
         (= m! a!)
         (= k! (bvadd k #x00000001)))
    (and (= j! j)
         (bvult k #x00000001)
         (bvugt m a!)
         (= k! (bvadd k #x00000001))))) (inv m! a! j! k!))))
(assert (forall ((m (_ BitVec 32)) (a (_ BitVec 32)) (j (_ BitVec 32)) (k (_ BitVec 32))) 
      (=> (inv m a j k) (or (bvult k #x00000001)
    (bvult a m)
    (= j (bvadd #x00000001 (bvnot #x00000001)))))))
(check-sat)
