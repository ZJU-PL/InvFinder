(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((x1 (_ BitVec 32)) (x2 (_ BitVec 32)) (x3 (_ BitVec 32)) (x4 (_ BitVec 32))) 
      (=> (and (= x1 #x00000000)
     (= x2 #x00000000)
     (= x3 #x00000000)
     (= x4 (bvadd #x00000001 (bvnot #x00000001)))) (inv x1 x2 x3 x4))))
(assert (forall ((x1 (_ BitVec 32)) (x2 (_ BitVec 32)) (x3 (_ BitVec 32)) (x4 (_ BitVec 32)) (x1! (_ BitVec 32)) (x2! (_ BitVec 32)) (x3! (_ BitVec 32)) (x4! (_ BitVec 32))) 
      (=> (and (inv x1 x2 x3 x4) (and (bvule x1! #x00000000)
     (bvuge x1! (bvadd x4! #x00000001))
     (= x2! x3!)
     (or (bvuge x4! #x00000000) (bvule x4! x3!)))) (inv x1! x2! x3! x4!))))
(assert (forall ((x1 (_ BitVec 32)) (x2 (_ BitVec 32)) (x3 (_ BitVec 32)) (x4 (_ BitVec 32))) 
      (=> (inv x1 x2 x3 x4) (and (bvule x1 #x00000000)
     (bvuge x1 (bvadd x4 #x00000001))
     (= x2 x3)
     (or (bvuge x4 #x00000000) (bvule x4 x3))))))
(check-sat)
