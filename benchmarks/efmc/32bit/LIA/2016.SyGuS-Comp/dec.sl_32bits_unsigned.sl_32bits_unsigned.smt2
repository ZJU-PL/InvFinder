(set-logic HORN)
(declare-fun inv ((_ BitVec 32) ) Bool)
(assert (forall ((x (_ BitVec 32))) 
      (=> (= x #x00000064) (inv x))))
(assert (forall ((x (_ BitVec 32)) (x! (_ BitVec 32))) 
      (=> (and (inv x) (and (bvugt x #x00000000) (= x! (bvsub x #x00000001)))) (inv x!))))
(assert (forall ((x (_ BitVec 32))) 
      (=> (inv x) (not (and (bvule x #x00000000) (not (= x #x00000000)))))))
(check-sat)
