(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((j (_ BitVec 32)) (k (_ BitVec 32)) (t (_ BitVec 32))) 
      (=> (and (= j #x00000002) (= k #x00000000)) (inv j k t))))
(assert (forall ((j (_ BitVec 32)) (k (_ BitVec 32)) (t (_ BitVec 32)) (j! (_ BitVec 32)) (k! (_ BitVec 32)) (t! (_ BitVec 32))) 
      (=> (and (inv j k t) (or (and (= t #x00000000)
         (= j! (bvadd j #x00000004))
         (= k! k)
         (= t! t))
    (and (not (= t #x00000000))
         (= j! (bvadd j #x00000002))
         (= k! (bvadd k #x00000001))
         (= t! t)))) (inv j! k! t!))))
(assert (forall ((j (_ BitVec 32)) (k (_ BitVec 32)) (t (_ BitVec 32))) 
      (=> (inv j k t) (or (= k #x00000000)
    (= j (bvadd (bvmul k #x00000002) #x00000002))))))
(check-sat)
