(set-logic HORN)
(declare-fun inv ((_ BitVec 128) ) Bool)
(assert (forall ((x (_ BitVec 128))) 
      (=> (= x #x00000000000000000000000000000000) (inv x))))
(assert (forall ((x (_ BitVec 128)) (x! (_ BitVec 128))) 
      (=> (and (inv x) (= x! #x00000000000000000000000000000000)) (inv x!))))
(assert (forall ((x (_ BitVec 128))) 
      (=> (inv x) (= x #x00000000000000000000000000000000))))
(check-sat)
