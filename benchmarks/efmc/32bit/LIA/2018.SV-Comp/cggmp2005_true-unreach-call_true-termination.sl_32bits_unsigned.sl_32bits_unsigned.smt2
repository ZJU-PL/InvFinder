(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((i (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (and (= i #x00000001) (= j #x0000000a)) (inv i j))))
(assert (forall ((i (_ BitVec 32)) (j (_ BitVec 32)) (i! (_ BitVec 32)) (j! (_ BitVec 32))) 
      (=> (and (inv i j) (and (bvuge j i)
     (= i! (bvadd i #x00000002))
     (= j! (bvadd j (bvsub #x00000000 #x00000001))))) (inv i! j!))))
(assert (forall ((i (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (inv i j) (or (bvuge j i) (= j #x00000006)))))
(check-sat)
