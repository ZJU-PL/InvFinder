(set-logic HORN)
(declare-fun inv ((_ BitVec 64) ) Bool)
(assert (forall ((x (_ BitVec 64))) 
      (=> (= x #x0000000000000000) (inv x))))
(assert (forall ((x (_ BitVec 64)) (x! (_ BitVec 64))) 
      (=> (and (inv x) (= x! #x0000000000000000)) (inv x!))))
(assert (forall ((x (_ BitVec 64))) 
      (=> (inv x) (= x #x0000000000000000))))
(check-sat)
