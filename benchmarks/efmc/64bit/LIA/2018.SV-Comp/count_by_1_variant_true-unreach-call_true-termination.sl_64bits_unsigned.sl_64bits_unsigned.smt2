(set-logic HORN)
(declare-fun inv ((_ BitVec 64) ) Bool)
(assert (forall ((i (_ BitVec 64))) 
      (=> (= i #x0000000000000000) (inv i))))
(assert (forall ((i (_ BitVec 64)) (i! (_ BitVec 64))) 
      (=> (and (inv i) (and (not (= i #x00000000000f4240)) (= i! (bvadd i #x0000000000000001)))) (inv i!))))
(assert (forall ((i (_ BitVec 64))) 
      (=> (inv i) (or (not (= i #x00000000000f4240)) (bvule i #x00000000000f4240)))))
(check-sat)
