(set-logic HORN)
(declare-fun inv ((_ BitVec 128) (_ BitVec 128) ) Bool)
(assert (forall ((x (_ BitVec 128)) (y (_ BitVec 128))) 
      (=> (and (= x #x00000000000000000000000000000000) (= y #x00000000000000000000000000000000)) (inv x y))))
(assert (forall ((x (_ BitVec 128)) (y (_ BitVec 128)) (x! (_ BitVec 128)) (y! (_ BitVec 128))) 
      (=> (and (inv x y) (and (= x! x) (bvule #x00000000000000000000000000000000 y) (= y! (bvadd x y)))) (inv x! y!))))
(assert (forall ((x (_ BitVec 128)) (y (_ BitVec 128))) 
      (=> (inv x y) (bvuge y #x00000000000000000000000000000000))))
(check-sat)
