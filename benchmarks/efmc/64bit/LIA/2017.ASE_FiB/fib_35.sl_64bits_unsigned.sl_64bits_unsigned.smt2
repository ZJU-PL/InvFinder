      (=> (and (bvugt n #x0000000000000000) (= x #x0000000000000000)) (inv x n))))
(assert (forall ((x (_ BitVec 64)) (n (_ BitVec 64)) (x! (_ BitVec 64)) (n! (_ BitVec 64))) 
      (=> (and (inv x n) (or (and (bvuge x n) (= x! x) (= n! n))
