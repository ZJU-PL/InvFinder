(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((n (_ BitVec 32)) (i (_ BitVec 32)) (k (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (and (bvule n #x000f4240)
     (= k n)
     (= i #x00000000)
     (= j #x00000000)) (inv n i k j))))
(assert (forall ((n (_ BitVec 32)) (i (_ BitVec 32)) (k (_ BitVec 32)) (j (_ BitVec 32)) (n! (_ BitVec 32)) (i! (_ BitVec 32)) (k! (_ BitVec 32)) (j! (_ BitVec 32))) 
      (=> (and (inv n i k j) (or (and (bvult i n)
         (= k! (bvsub k #x00000001))
         (= i! (bvadd i #x00000002))
         (= n! n)
         (= j! j))
    (and (bvuge i n)
         (bvult j (bvsdiv n #x00000002))
         (= k! (bvsub k #x00000001))
         (= j! (bvadd j #x00000001))
         (= i! i)
         (= n! n)))) (inv n! i! k! j!))))
(assert (forall ((n (_ BitVec 32)) (i (_ BitVec 32)) (k (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (inv n i k j) (let ((a!1 (not (and (bvuge i n) (bvult j (bvsdiv n #x00000002))))))
  (or a!1 (bvugt k #x00000000))))))
(check-sat)
