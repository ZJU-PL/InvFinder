(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((n (_ BitVec 32)) (i (_ BitVec 32)) (k (_ BitVec 32)) (j (_ BitVec 32))) 
      (=> (and (= i #x00000000) (= k #x00000000) (= j #x00000000)) (inv n i k j))))
(assert (forall ((n (_ BitVec 32)) (i (_ BitVec 32)) (k (_ BitVec 32)) (j (_ BitVec 32)) (n! (_ BitVec 32)) (i! (_ BitVec 32)) (k! (_ BitVec 32)) (j! (_ BitVec 32))) 
      (=> (and (inv n i k j) (or (and (bvult i n)
