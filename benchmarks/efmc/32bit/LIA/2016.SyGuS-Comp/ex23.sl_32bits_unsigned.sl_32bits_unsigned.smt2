(set-logic HORN)
(declare-fun inv ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) ) Bool)
(assert (forall ((y (_ BitVec 32)) (z (_ BitVec 32)) (c (_ BitVec 32))) 
      (=> (and (= c #x00000000)
     (bvuge y #x00000000)
     (bvuge #x0000007f y)
     (= z (bvmul #x00000024 y))) (inv y z c))))
(assert (forall ((y (_ BitVec 32)) (z (_ BitVec 32)) (c (_ BitVec 32)) (y! (_ BitVec 32)) (z! (_ BitVec 32)) (c! (_ BitVec 32))) 
      (=> (and (inv y z c) (and (bvult c #x00000024)
     (= z! (bvadd z #x00000001))
     (= c! (bvadd c #x00000001))
     (= y! y))) (inv y! z! c!))))
(assert (forall ((y (_ BitVec 32)) (z (_ BitVec 32)) (c (_ BitVec 32))) 
      (=> (inv y z c) (not (and (bvult c #x00000024)
          (or (bvult z #x00000000) (bvuge z #x00001200)))))))
(check-sat)
